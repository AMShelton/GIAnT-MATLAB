+function raw = applyValidityMask(raw, valid2D)
+% Mask pixels that fail the whole-trial NaN-fraction criterion.
+if all(valid2D,'all')
+    return
+end
+bad = ~valid2D;
+for t = 1:size(raw,3)
+    frame = raw(:,:,t);
+    frame(bad) = nan;
+    raw(:,:,t) = frame;
+end
+end
+
